CI_ENVIRONMENT = development

app.baseURL = 'http://analitie-rsuph.test'
app.appTimezone = 'Asia/Makassar'
app.defaultLocale = id
app.indexPage = ''
routing.translateURIDashes = true

database.default.hostname = 127.0.0.1
database.default.database = analitie_rsuph
database.default.username = root
database.default.password =
database.default.port = 3306

database.sik.hostname = 127.0.0.1
database.sik.database = sik_rsuph
database.sik.username = root
database.sik.password =
database.sik.port = 3306

session.cookieName = 'analitie_rsuph_session'
session.expiration = 360000
security.tokenName = 'analitie_rsuph_csrf_token'
security.cookieName = 'analitie_rsuph_csrf_cookie'
security.expires = 360000
security.regenerate = false

PASSWORD_PEPPER = 'password-pepper'
HASHIDS_PEPPER = 'hashids-pepper'

APP_TITLE = 'Analitie RSUPH'
APP_FOOTER = 'Analitie'
APP_AUTH_TITLE = '<span style="letter-spacing: 2px;">Analitie</span> <span class="font-weight-bold" style="letter-spacing: 8px;">RSUPH</span>'
APP_SIDEBAR_TITLE = '<span style="letter-spacing: 1px;">Analitie</span> <span class="font-weight-bold" style="letter-spacing: 5px;">RSUPH</span>'
APP_SIDEBAR_LOGO = 'logo-bg-white.png'
